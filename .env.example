# Copy to .env and fill in real values.

# Sectors API
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app

# LLM (primary provider)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# LLM (fallback provider, used on primary rate limit/error)
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage
KUARTAL_DB_PATH=./kuartal.db

# API server
API_HOST=0.0.0.0
API_PORT=8000
MOCK_MODE=true

# Scheduler
POLL_INTERVAL_SECONDS=3600
SCHEDULER_RESTART_BACKOFF_SECONDS=5

# Pipeline stage toggles
PIPELINE_ENABLE_LLM=true
PIPELINE_ENABLE_DELIVERY=true
